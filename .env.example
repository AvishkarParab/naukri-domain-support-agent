# Naukri Domain Support Agent Configuration

# Execution Mode: "mock" (offline/zero-cost) or "live"
LLM_MODE=mock

# Agent & Guardrail Controls
MAX_TOKEN_BUDGET_PER_REQUEST=350
ESCALATION_THRESHOLD=0.70
AUDIT_LOG_PATH=agent_audit.jsonl

# CrewAI & Framework Telemetry
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Live Provider Keys (Optional: Only used when LLM_MODE=live)
# OPENAI_API_KEY=your_openai_api_key_here